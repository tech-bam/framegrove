{
 "name":"framegrove",
 "main":"worker.mjs",
 "compatibility_date":"2026-10-01",
 "routes":[
  {"pattern":"framegrove.bamstudio.dev","custom_domain":true},
  {"pattern":"bamstudio.dev/web/store-mockup/*","zone_name":"bamstudio.dev"}
 ],
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true,"html_handling":"auto-trailing-slash","not_found_handling":"404-page"},
 "observability":{"enabled":true}
}
